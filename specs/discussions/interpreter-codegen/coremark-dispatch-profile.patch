+use ab_riscv_interpreter::{ExecutionError, FetchInstructionResult, InstructionFetcher, ProgramCounter};
+use ab_riscv_primitives::prelude::*;
+use core::ops::ControlFlow;
+use std::io::Write;
+
+pub struct ProfilingFetcher<IF> {
+    inner: IF,
+    dispatches: u64,
+    counts: Vec<u64>,
+    // per-PC: how many times a relative branch/jump was taken (try_set_pc_relative succeeded)
+    taken: Vec<u64>,
+    last_pc: u64,
+}
+
+impl<IF> ProfilingFetcher<IF> {
+    pub fn new(inner: IF) -> Self {
+        Self { inner, dispatches: 0, counts: vec![0; 1 << 20], taken: vec![0; 1 << 20], last_pc: 0 }
+    }
+    pub fn dispatches(&self) -> u64 { self.dispatches }
+    pub fn dump(&self, path: &str) {
+        let mut f = std::fs::File::create(path).unwrap();
+        for (i, c) in self.counts.iter().enumerate() {
+            if *c != 0 { writeln!(f, "{:x} {} {}", i * 2, c, self.taken[i]).unwrap(); }
+        }
+    }
+}
+
+impl<IF, Memory> ProgramCounter<u64, Memory> for ProfilingFetcher<IF>
+where
+    IF: ProgramCounter<u64, Memory>,
+{
+    #[inline(always)]
+    fn get_pc(&self) -> u64 { self.inner.get_pc() }
+    #[inline(always)]
+    unsafe fn try_set_pc_relative(&mut self, instruction_size: u8, offset: i32) -> bool {
+        let r = unsafe { self.inner.try_set_pc_relative(instruction_size, offset) };
+        if r { self.taken[(self.last_pc / 2) as usize] += 1; }
+        r
+    }
+    #[inline(always)]
+    unsafe fn failed_branch(&mut self, memory: &Memory) -> Result<ControlFlow<()>, ExecutionError<u64>> {
+        unsafe { self.inner.failed_branch(memory) }
+    }
+    #[inline(always)]
+    fn set_pc(&mut self, memory: &Memory, pc: u64) -> Result<ControlFlow<()>, ExecutionError<u64>> {
+        self.inner.set_pc(memory, pc)
+    }
+}
+
+impl<IF, I, Memory> InstructionFetcher<I, Memory> for ProfilingFetcher<IF>
+where
+    IF: InstructionFetcher<I, Memory> + ProgramCounter<u64, Memory>,
+    I: Instruction,
+    I::Reg: Register<Type = u64>,
+{
+    type Peeked = IF::Peeked;
+    #[inline(always)]
+    fn peek_instruction(&mut self, memory: &Memory) -> FetchInstructionResult<I, Self::Peeked> { self.inner.peek_instruction(memory) }
+    #[inline(always)]
+    fn peeked_instruction<'a>(&'a self, peeked: &'a Self::Peeked) -> &'a I { self.inner.peeked_instruction(peeked) }
+    #[inline(always)]
+    unsafe fn advance(&mut self, instruction_size: u8) { unsafe { self.inner.advance(instruction_size) } }
+    #[inline(always)]
+    fn fetch_instruction(&mut self, memory: &Memory) -> FetchInstructionResult<I> {
+        let pc: u64 = ProgramCounter::<u64, Memory>::get_pc(&self.inner);
+        let result = self.inner.fetch_instruction(memory);
+        if let FetchInstructionResult::Instruction(_) = &result {
+            self.dispatches = self.dispatches.wrapping_add(1);
+            self.last_pc = pc;
+            if let Some(c) = self.counts.get_mut((pc / 2) as usize) { *c += 1; }
+        }
+        result
+    }
+}
